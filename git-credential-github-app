#!/usr/bin/env bash
# JWT flow adapted from GitHub's official Bash example; see README references.
set +x
set -euo pipefail

usage() {
  echo 'Usage: git-credential-github-app --app-id ID --installation-id ID --owner OWNER'
  echo '       --key-file PATH [--contents-permission read|write] {get|store|erase}'
}
fail() {
  printf 'quit=true\n\n'
  printf 'git-credential-github-app: %s\n' "$1" >&2
  exit 1
}
app_id='' installation_id='' owner='' key_file='' permission='write'
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --app-id|--installation-id|--owner|--key-file|--contents-permission)
      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail "Missing value for $1"
      case "$1" in
        --app-id) app_id="$2" ;;
        --installation-id) installation_id="$2" ;;
        --owner) owner="$2" ;;
        --key-file) key_file="$2" ;;
        --contents-permission) permission="$2" ;;
      esac
      shift 2 ;;
    get|store|erase) break ;;
    *) fail "Unknown argument: $1" ;;
  esac
done
[[ $# == 1 ]] || fail 'Expected exactly one operation: get, store, or erase.'
case "$1" in
  store|erase) exit 0 ;; # Stateless: nothing to persist or erase.
  get) ;;
esac
trap 'fail "Authentication failed; check arguments, key, network and app permissions."' ERR

protocol='' host='' repo_path=''
while IFS='=' read -r field value && [[ -n "$field" ]]; do
  case "$field" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    path) repo_path="$value" ;;
  esac
done
# Decline unrelated hosts so another helper can run.
if [[ "$protocol" != https || "$host" != github.com ]]; then exit 0; fi
for dependency in jq openssl curl; do
  command -v "$dependency" >/dev/null || fail "Missing dependency: $dependency"
done
[[ "$app_id" =~ ^[A-Za-z0-9_.-]+$ ]] || fail 'Set --app-id to an App ID or Client ID.'
[[ "$installation_id" =~ ^[0-9]+$ ]] || fail 'Set --installation-id to a numeric ID.'
[[ "$owner" =~ ^[A-Za-z0-9-]+$ ]] || fail 'Set --owner to a GitHub user or organization.'
[[ "$permission" == read || "$permission" == write ]] || fail '--contents-permission must be read or write.'
case "$key_file" in
  '~/'*) key_file="$HOME/${key_file#\~/}" ;;
  /*) ;;
  *) fail '--key-file must be an absolute path or start with ~/.' ;;
esac
repo_path="${repo_path%.git}"
[[ "$repo_path" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$ ]] ||
  fail 'Expected OWNER/REPO path; enable credential.useHttpPath.'
requested_owner="${repo_path%%/*}"
if [[ "$(printf '%s' "$requested_owner" | tr '[:upper:]' '[:lower:]')" != \
      "$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')" ]]; then exit 0; fi
repo="${repo_path#*/}"
[[ -r "$key_file" ]] || fail 'Cannot read configured private key.'

base64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
header=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | base64url)
claims=$(jq -nc --arg iss "$app_id" --argjson now "$now" \
  '{iss:$iss,iat:($now-60),exp:($now+540)}' | base64url)
signature=$(printf '%s' "$header.$claims" |
  openssl dgst -sha256 -sign "$key_file" -binary | base64url)
jwt="$header.$claims.$signature"

# Disable curlrc; no redirects or secrets in argv. Header comes from stdin.
github_api() {
  printf 'Authorization: Bearer %s\n' "$jwt" |
    curl --disable --silent --show-error --fail --max-time 30 \
      --proto '=https' --header @- \
      --header 'Accept: application/vnd.github+json' \
      --header 'Content-Type: application/json' \
      --header 'X-GitHub-Api-Version: 2026-03-10' "$@"
}
# Catch mismatched installation IDs before requesting tokens by repository name.
installation=$(github_api "https://api.github.com/app/installations/$installation_id")
jq -e --arg owner "$owner" \
  '(.account.login | ascii_downcase) == ($owner | ascii_downcase)' \
  <<< "$installation" >/dev/null || fail 'Installation belongs to another owner.'
body=$(jq -nc --arg repo "$repo" --arg permission "$permission" \
  '{repositories:[$repo],permissions:{contents:$permission}}')
token=$(github_api --request POST --data "$body" \
  "https://api.github.com/app/installations/$installation_id/access_tokens" |
  jq -er '.token | select(type == "string" and length > 0 and (test("[\\r\\n]") | not))')
# Output is consumed by Git. Do not run get in a terminal.
printf 'username=x-access-token\npassword=%s\n\n' "$token"

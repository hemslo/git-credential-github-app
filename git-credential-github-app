#!/usr/bin/env bash
# JWT flow adapted from GitHub's official Bash example; see README references.
set +x
set -euo pipefail

usage() {
  echo 'Usage: git-credential-github-app --app-id ID --installation-id ID --owner OWNER'
  echo '       --key-file PATH [--contents-permission read|write] {get|store|erase}'
  echo '       --key-file PATH [--cache-dir PATH] token'
}
fail() {
  if [[ "${operation:-get}" != token ]]; then printf 'quit=true\n\n'; fi
  printf 'git-credential-github-app: %s\n' "$1" >&2
  exit 1
}
operation=get
for arg in "$@"; do [[ "$arg" != token ]] || operation=token; done
app_id='' installation_id='' owner='' key_file='' permission=''
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/git-credential-github-app"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --app-id|--installation-id|--owner|--key-file|--contents-permission|--cache-dir)
      [[ $# -ge 2 && -n "$2" && "$2" != --* ]] || fail "Missing value for $1"
      case "$1" in
        --cache-dir) cache_dir="$2" ;;
        --app-id) app_id="$2" ;;
        --installation-id) installation_id="$2" ;;
        --owner) owner="$2" ;;
        --key-file) key_file="$2" ;;
        --contents-permission) permission="$2" ;;
      esac
      shift 2 ;;
    get|store|erase|token) break ;;
    *) fail "Unknown argument: $1" ;;
  esac
done
[[ $# == 1 ]] || fail 'Expected exactly one operation: get, store, erase, or token.'
operation="$1"
[[ "$operation" != store ]] || exit 0
trap 'fail "Authentication failed; check arguments, key, network and app permissions."' ERR

protocol='' host='' repo_path=''
if [[ "$operation" != token ]]; then
while IFS='=' read -r field value && [[ -n "$field" ]]; do
  case "$field" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
    path) repo_path="$value" ;;
  esac
done
# Decline unrelated hosts so another helper can run.
if [[ "$protocol" != https || "$host" != github.com ]]; then exit 0; fi
fi
for dependency in jq openssl curl; do
  command -v "$dependency" >/dev/null || fail "Missing dependency: $dependency"
done
[[ "$app_id" =~ ^[A-Za-z0-9_.-]+$ ]] || fail 'Set --app-id to an App ID or Client ID.'
[[ "$installation_id" =~ ^[0-9]+$ ]] || fail 'Set --installation-id to a numeric ID.'
[[ "$owner" =~ ^[A-Za-z0-9-]+$ ]] || fail 'Set --owner to a GitHub user or organization.'
[[ -z "$permission" || "$permission" == read || "$permission" == write ]] || fail '--contents-permission must be read or write.'
case "$key_file" in
  '~/'*) key_file="$HOME/${key_file#\~/}" ;;
  /*) ;;
  *) fail '--key-file must be an absolute path or start with ~/.' ;;
esac
if [[ "$operation" != token ]]; then
repo_path="${repo_path%.git}"
[[ "$repo_path" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$ ]] ||
  fail 'Expected OWNER/REPO path; enable credential.useHttpPath.'
requested_owner="${repo_path%%/*}"
if [[ "$(printf '%s' "$requested_owner" | tr '[:upper:]' '[:lower:]')" != \
      "$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')" ]]; then exit 0; fi
repo="${repo_path#*/}"
fi
[[ -r "$key_file" ]] || fail 'Cannot read configured private key.'

# An empty request inherits all repositories and permissions granted to the installation.
body='{}'
if [[ -n "$permission" ]]; then
  body=$(jq -nc --arg permission "$permission" '{permissions:{contents:$permission}}')
  if [[ "$operation" != token ]]; then
    body=$(jq -c --arg repo "$repo" '. + {repositories:[$repo]}' <<< "$body")
  fi
fi
emit_token() {
  if [[ "$operation" == token ]]; then
    printf '%s\n' "$1"
  else
    printf 'username=x-access-token\npassword=%s\n\n' "$1"
  fi
}
cache_file='' cache_tmp=''
umask 077
[[ "$cache_dir" == /* ]] || fail '--cache-dir must be absolute.'
[[ ! -L "$cache_dir" ]] || fail 'Cache directory must not be a symlink.'
mkdir -p "$cache_dir"
[[ -d "$cache_dir" && -O "$cache_dir" ]] || fail 'Cache directory must be owned by this user.'
chmod 700 "$cache_dir"
identity=$(printf '%s\n' "$app_id" "$installation_id" "$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')" "$body" | openssl dgst -sha256)
key_identity=$(openssl pkey -in "$key_file" -pubout 2>/dev/null | openssl dgst -sha256)
cache_id=$(printf '%s\n' "$identity" "$key_identity" | openssl dgst -sha256 | awk '{print $NF}')
cache_file="$cache_dir/$cache_id.json"
if [[ "$operation" == erase ]]; then
  rm -f "$cache_file"
  exit 0
fi
if [[ -f "$cache_file" && ! -L "$cache_file" && -O "$cache_file" ]]; then
  chmod 600 "$cache_file"
  if cached=$(jq -er --argjson now "$(date +%s)" '
    select((.expires_at | fromdateiso8601) > ($now + 60)) |
    .token | select(type == "string" and length > 0 and (test("[\\r\\n]") | not))
    ' "$cache_file" 2>/dev/null); then
    emit_token "$cached"
    exit 0
  fi
fi

base64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
header=$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | base64url)
claims=$(jq -nc --arg iss "$app_id" --argjson now "$now" \
  '{iss:$iss,iat:($now-60),exp:($now+540)}' | base64url)
signature=$(printf '%s' "$header.$claims" |
  openssl dgst -sha256 -sign "$key_file" -binary | base64url)
jwt="$header.$claims.$signature"

# Disable curlrc; no redirects or secrets in argv. Header comes from stdin.
github_api() {
  printf 'Authorization: Bearer %s\n' "$jwt" |
    curl --disable --silent --show-error --fail --max-time 30 \
      --proto '=https' --header @- \
      --header 'Accept: application/vnd.github+json' \
      --header 'Content-Type: application/json' \
      --header 'X-GitHub-Api-Version: 2026-03-10' "$@"
}
# Verify the configured installation owner before minting a token.
installation=$(github_api "https://api.github.com/app/installations/$installation_id")
jq -e --arg owner "$owner" \
  '(.account.login | ascii_downcase) == ($owner | ascii_downcase)' \
  <<< "$installation" >/dev/null || fail 'Installation belongs to another owner.'
response=$(github_api --request POST --data "$body" \
  "https://api.github.com/app/installations/$installation_id/access_tokens")
token=$(printf '%s' "$response" | jq -er '.token | select(type == "string" and length > 0 and (test("[\\r\\n]") | not))')
printf '%s' "$response" | jq -e --argjson now "$(date +%s)" \
    '(.expires_at | fromdateiso8601) > ($now + 60)' >/dev/null || fail 'Invalid token expiry.'
trap '[[ -z "$cache_tmp" ]] || rm -f "$cache_tmp"' EXIT
cache_tmp=$(mktemp "$cache_dir/.token.XXXXXX")
printf '%s' "$response" | jq '{token,expires_at}' > "$cache_tmp"
mv -f "$cache_tmp" "$cache_file"
cache_tmp=''
emit_token "$token"
